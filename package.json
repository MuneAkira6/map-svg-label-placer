{
  "name": "map-svg-label-placer",
  "version": "0.0.0",
  "description": "Move the place names on an SVG map so they don't cover lines, symbols or each other.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "map-svg-label-placer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "oracle": "python3 -I -X utf8 reference/oracle.py",
    "regress": "npm run build && node scripts/commons_regress.mjs run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
